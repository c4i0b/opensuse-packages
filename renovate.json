{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": "Track upstream releases for openSUSE packages",
  "schedule": ["at any time"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate dashboard — opensuse-packages",
  "labels": ["dependencies"],
  "branchPrefix": "renovate/",
  "prConcurrentLimit": 1,
  "lockFileMaintenance": { "enabled": false },
  "customManagers": [
    {
      "description": "Bump opencode version atomically across VERSION, _service and .spec",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "managerFilePatterns": [
        "^tools/opencode-bin/VERSION$",
        "^tools/opencode-bin/_service$",
        "^tools/opencode-bin/opencode-bin\\.spec$"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$",
        "/v(?<currentValue>[^/]+)/",
        "(?:^|\\r\\n|\\r|\\n)Version:\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "Bump fisher version atomically across VERSION, _service and .spec",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jorgebucaran/fisher",
      "managerFilePatterns": [
        "^tools/fisher/VERSION$",
        "^tools/fisher/_service$",
        "^tools/fisher/fisher\\.spec$"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$",
        "/fisher/archive/(?<currentValue>[^/]+)/",
        "fisher-(?<currentValue>[^/]+)\\.tar\\.gz",
        "(?:^|\\r\\n|\\r|\\n)Version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "opencode versioning, commit style and automerge",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["anomalyco/opencode"],
      "versioning": "semver",
      "extractVersion": "^v?(?<version>.+)$",
      "commitMessage": "chore(opencode): bump to {{newVersion}}",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "requiredStatusChecks": ["validate-bump"]
    },
    {
      "description": "fisher versioning, commit style and automerge",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["jorgebucaran/fisher"],
      "versioning": "semver",
      "commitMessage": "chore(fisher): bump to {{newVersion}}",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "requiredStatusChecks": ["validate-bump"]
    }
  ]
}
