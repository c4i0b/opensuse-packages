{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": "Track upstream anomalyco/opencode releases for the openSUSE opencode package",
  "schedule": ["before 6am"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate dashboard — opensuse-packages",
  "labels": ["dependencies", "opencode"],
  "branchPrefix": "renovate/",
  "prConcurrentLimit": 1,
  "lockFileMaintenance": { "enabled": false },
  "customManagers": [
    {
      "description": "Bump opencode version atomically across VERSION, _service and .spec",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "managerFilePatterns": [
        "^tools/opencode/VERSION$",
        "^tools/opencode/_service$",
        "^tools/opencode/opencode\\.spec$"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$",
        "/v(?<currentValue>[^/]+)/",
        "(?:^|\\r\\n|\\r|\\n)Version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "opencode versioning, commit style and automerge",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["anomalyco/opencode"],
      "versioning": "semver",
      "extractVersion": "^v?(?<version>.+)$",
      "commitMessage": "chore(opencode): bump to {{newVersion}}",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "requiredStatusChecks": ["validate-bump"]
    }
  ]
}
