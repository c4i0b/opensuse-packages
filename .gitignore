# archives and build artifacts (sources are fetched via _service)
*.tar.gz
*.tar.zst
*.zip
*.rpm
*.log
*.pyc
__pycache__/
.build/
.binaries/

# extensionless Bun prebuilt fetched for local pre-flight builds; upstream
# asset names are gitignore-unsafe (no extension, >100 MB) — one-off local
# ignore, mirrors the per-package .obsignore entry
packages/omo/omo-linux-*

# osc working copies
work/

# credentials never enter git
.oscrc
.netrc
.env*

# AI tool local files (agents read AGENTS.md only)
CLAUDE.md
.agents/
.claude/
.cursor/
.codex/

# bd hooks install keeps pre-injection copies here (docs/workflow.md)
.githooks/*.backup

# beads state is local, never committed (docs/workflow.md)
.beads/
*.gate.lock*
.worktrees/
