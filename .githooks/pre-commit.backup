#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
# Runs wherever python3 lives: directly on the host, or through podman
# compose when invoked by a host that only has git + podman.
if command -v python3 >/dev/null 2>&1; then
  exec bash "$root/tools/pre-commit.sh" "$@"
fi
exec podman compose -f "$root/compose.yml" run --rm -T tooling \
  bash tools/pre-commit.sh "$@"
