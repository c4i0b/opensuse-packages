# Bundled Electron tree inside /usr/lib/hydra-launcher: upstream ships
# node headers (.h/.c), npm scripts and helper ELFs we neither strip nor
# want rpm to treat as system libraries.
addFilter("hydra-launcher.*devel-file-in-non-devel-package")
addFilter("hydra-launcher.*env-script-interpreter")
addFilter("hydra-launcher.*non-executable-script")
addFilter("hydra-launcher.*script-without-shebang")
addFilter("hydra-launcher.*bin-sh-syntax-error")
addFilter("hydra-launcher.*missing-hash-section")
addFilter("hydra-launcher.*library-without-ldconfig-postun")
addFilter("hydra-launcher.*library-without-ldconfig-postin")
addFilter("hydra-launcher.*hidden-file-or-dir")
addFilter("hydra-launcher.*binary-or-shlib-calls-gethostbyname")
addFilter("hydra-launcher.*unstripped-binary-or-object")
# resources/legendary embeds a private python/tcl runtime: stub .pyi files,
# static archives, rpath pointing at its own /tools/deps (never system)
addFilter("hydra-launcher.*zero-length /usr/lib64/hydra-launcher/resources/legendary/")
addFilter("hydra-launcher.*statically-linked-binary /usr/lib64/hydra-launcher/resources/7zzs")
addFilter("hydra-launcher.*static-library-without-debuginfo")
addFilter("hydra-launcher.*shared-library-not-executable /usr/lib64/hydra-launcher/resources/app.asar.unpacked/")
addFilter("hydra-launcher.*binary-or-shlib-defines-rpath /usr/lib64/hydra-launcher/resources/legendary/")
# bundled ELFs' own requires are excluded; the host libs they dlopen are
# declared explicitly on the package
addFilter("hydra-launcher.*explicit-lib-dependency")
