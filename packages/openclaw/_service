<services>
  <!-- dependency closure travels as node_modules.obscpio (worker
       auto-unpacks *.obscpio into SOURCES); the spec.inc Source10000+
       registry URLs are SRPM provenance only -->
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">registry.npmjs.org</param>
    <param name="path">/openclaw/-/openclaw-2026.11.8.tgz</param>
    <param name="filename">openclaw-2026.11.8.tgz</param>
  </service>
</services>
