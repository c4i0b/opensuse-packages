<services>
  <service name="tar_scm" mode="serveronly">
    <param name="url">https://github.com/storytold/vectorcraft.git</param>
    <param name="scm">git</param>
    <param name="revision">v0.24.1</param>
    <!-- literal version: the gateway tar_scm has no version rewrite params and
         @PARENT_TAG@ keeps the v prefix, which breaks set_version -->
    <param name="versionformat">0.24.1</param>
    <param name="exclude">.git</param>
  </service>
  <service name="recompress" mode="serveronly">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="set_version" mode="serveronly"/>
  <!-- cargo_vendor is not in the server-side allowlist of api.opensuse.org:
       vendor.tar.zst is regenerated client-side (see rust-source.spec.tpl)
       and pushed alongside the sources. -->
  <service name="cargo_vendor" mode="manual">
    <param name="srcdir">vectorcraft</param>
    <param name="compression">zst</param>
  </service>
</services>
