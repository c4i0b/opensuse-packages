<services>
  <service name="tar_scm">
    <param name="url">https://github.com/radiolamp/mangojuice.git</param>
    <param name="scm">git</param>
    <param name="exclude">.git</param>
    <param name="revision">1.0.0</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <!-- tag 1.0.0 references a flatpak-only submodule with no URL in
         .gitmodules; git submodule update fails and tar_scm aborts -->
    <param name="submodules">disable</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version"/>
</services>
