# Template: bun single-file prebuilt (validated by packages/opencode-bin).
# Invariant: OBS brp-strip corrupts bun binaries (payload appended to the ELF),
# so %global __os_install_post %{nil} is mandatory. Without it the binary
# silently falls back to the Bun CLI at runtime.
# Changelog lives in <name>.changes (OBS merges it into %changelog), so the
# spec's %changelog section stays empty.
%global __os_install_post %{nil}

Name:           __NAME__
Version:        __VERSION__
Release:        0
Summary:        __SUMMARY__
License:        __LICENSE__
URL:            __URL__
Source0:        __SOURCE0__
Source1:        LICENSE
ExclusiveArch:  x86_64

BuildRequires:  tar
Provides:       __PROVIDES__ = %{version}-%{release}
Obsoletes:      __PROVIDES__ < %{version}-%{release}
Recommends:     bash-completion

%description
__DESCRIPTION__

%prep
%setup -T -c -D
tar -xzf %{SOURCE0}

%build

%install
install -Ddm755 %{buildroot}%{_bindir}
install -pm 0755 __BIN__ %{buildroot}%{_bindir}/__BIN__

# Completions generated by running the prebuilt binary (drop any shell it
# does not support). The %dir lines below are mandatory: OBS check-filelist
# FAILs on unowned zsh/fish dirs.
./__BIN__ completion bash > __BIN__.bash
./__BIN__ completion zsh  > ___BIN__
./__BIN__ completion fish > __BIN__.fish
install -Dpm 0644 __BIN__.bash %{buildroot}%{_datadir}/bash-completion/completions/__BIN__
install -Dpm 0644 ___BIN__     %{buildroot}%{_datadir}/zsh/site-functions/___BIN__
install -Dpm 0644 __BIN__.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/__BIN__.fish

install -pm 0644 %{SOURCE1} LICENSE

%files
%license LICENSE
%{_bindir}/__BIN__
%{_datadir}/bash-completion/completions/__BIN__
%dir %{_datadir}/zsh
%dir %{_datadir}/zsh/site-functions
%{_datadir}/zsh/site-functions/___BIN__
%dir %{_datadir}/fish
%dir %{_datadir}/fish/vendor_completions.d
%{_datadir}/fish/vendor_completions.d/__BIN__.fish

%changelog
