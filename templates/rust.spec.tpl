# Template: Rust prebuilt release binary (validated by packages/television-bin).
# Invariants: Rust prebuilts are strip-safe (no __os_install_post). The release
# tarball bundles LICENSE, a manpage and the binary itself. Completions are
# generated by running the prebuilt binary, and the zsh/fish parent dirs must
# be owned via %dir or OBS check-filelist FAILs.
# Changelog lives in <name>.changes (OBS merges it into %changelog).
Name:           __NAME__
Version:        __VERSION__
Release:        0
Summary:        __SUMMARY__
License:        __LICENSE__
URL:            __URL__
Source0:        __SOURCE0__
ExclusiveArch:  x86_64

%description
__DESCRIPTION__

%prep
%setup -T -c -D
tar -xzf %{SOURCE0}

%build

%install
src="__EXTRACTDIR__"
install -Dpm 0755 "$src/__BIN__" %{buildroot}%{_bindir}/__BIN__
install -Dpm 0644 "$src/LICENSE" LICENSE
# Only if the tarball ships a manpage (already gzipped upstream):
install -Dpm 0644 "$src/doc/__BIN__.1" %{buildroot}%{_mandir}/man1/__BIN__.1.gz
mkdir -p %{buildroot}%{_datadir}/bash-completion/completions %{buildroot}%{_datadir}/zsh/site-functions %{buildroot}%{_datadir}/fish/vendor_completions.d
"$src/__BIN__" __INITCMD__ bash > %{buildroot}%{_datadir}/bash-completion/completions/__BIN__
"$src/__BIN__" __INITCMD__ zsh  > %{buildroot}%{_datadir}/zsh/site-functions/___BIN__
"$src/__BIN__" __INITCMD__ fish > %{buildroot}%{_datadir}/fish/vendor_completions.d/__BIN__.fish

%files
%license LICENSE
%{_bindir}/__BIN__
%{_mandir}/man1/__BIN__.1.gz
%{_datadir}/bash-completion/completions/__BIN__
%dir %{_datadir}/zsh
%dir %{_datadir}/zsh/site-functions
%{_datadir}/zsh/site-functions/___BIN__
%dir %{_datadir}/fish
%dir %{_datadir}/fish/vendor_completions.d
%{_datadir}/fish/vendor_completions.d/__BIN__.fish

%changelog
